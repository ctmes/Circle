# Circle — production environment.
#
# Copy to api/.env on the server and fill in. Nothing here has a safe default:
# every value left as it ships is either a placeholder that will break at the
# first request, or a local-development choice that would be a mistake on a box
# other people can reach.
#
# Generate the key once, on the server:  php artisan key:generate

APP_NAME=Circle
APP_ENV=production
APP_KEY=
# Stack traces name your file paths, your queries and sometimes your secrets.
APP_DEBUG=false
APP_URL=https://circle.example.com

# Where the browser is. Used for every link in every email — an invitation
# pointing at the API is an invitation nobody can accept.
WEB_APP_URL=https://circle.example.com

# The API and the front end share one origin in the production compose file, so
# this is that origin and nothing else. Never `*` on a reachable host.
CORS_ALLOWED_ORIGINS=https://circle.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------
# Must match POSTGRES_* in the compose environment.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=circle
DB_USERNAME=circle
DB_PASSWORD=

# --- Cache, queue, sessions -------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- Object storage ---------------------------------------------------------
# As shipped this points at the MinIO container in the same stack. Point it at
# managed storage (S3, Cloudflare R2, Spaces) when the contents start to matter:
# change these five values, change nothing else, and durability and backups
# become somebody else's job.
#
# AWS_ENDPOINT is how the API reaches it from inside the network.
# AWS_PUBLIC_ENDPOINT is how the browser reaches it. They differ, and both are
# needed, because an S3 signature covers the host it was signed against.
FILESYSTEM_DISK=evidence
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=circle-evidence
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://minio:9000
AWS_PUBLIC_ENDPOINT=https://files.circle.example.com

# --- Mail -------------------------------------------------------------------
# Without this, invitations and every other notification are written to the log
# and nobody is told anything. Any SMTP provider works; the sending domain has
# to be one you have verified with them, or mail from it goes to spam.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=circle@circle.example.com
MAIL_FROM_NAME=Circle

# Set to false to stop the product telling anybody anything. Useful for a dry
# run against real data before you invite anyone.
CIRCLE_NOTIFICATIONS=true

# --- The Steward ------------------------------------------------------------
# Without a key, agent runs fail loudly and are recorded as failed. They never
# return an empty brief that looks like a real one.
ANTHROPIC_API_KEY=
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-opus-5

# --- Transcription (optional) -----------------------------------------------
# Unset means audio and video transcripts are marked skipped rather than left
# pending. Any OpenAI-compatible /audio/transcriptions endpoint works.
TRANSCRIPTION_DRIVER=null
TRANSCRIPTION_API_KEY=
