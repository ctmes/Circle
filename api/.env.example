APP_NAME=Circle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=circle
DB_USERNAME=circle
DB_PASSWORD=circle

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Must stay above the longest Horizon supervisor timeout (media, 900s). Below
# it, Redis releases a job that is still running and it gets processed twice.
REDIS_QUEUE_RETRY_AFTER=1200

REDIS_HOST=redis
REDIS_PORT=6379

# --- Evidence object storage (MinIO in dev, Cloudflare R2 in production) ---
FILESYSTEM_DISK=evidence
AWS_ACCESS_KEY_ID=circle
AWS_SECRET_ACCESS_KEY=circlecircle
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=circle-evidence
AWS_USE_PATH_STYLE_ENDPOINT=true
# Endpoint reachable from inside the container (server-side reads/writes)
AWS_ENDPOINT=http://minio:9000
# Endpoint reachable from the browser. Presigned URLs must be signed against
# the host the browser will actually call, so signing uses this one.
AWS_PUBLIC_ENDPOINT=http://localhost:19000

# --- Circle Steward agent ---
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-5
# One model per job. Convening reads a document into a schema PHP re-checks;
# the brief is the judgement-heavy one. See config/circle.php for the reasoning
# and for why convening is the one to think hardest about before going cheaper.
AGENT_MODEL_CONVENING=claude-sonnet-5
AGENT_EFFORT_CONVENING=low
# Characters of document text one convening run reads, shared across the
# documents named. Separate from the Steward's per-document cap, which would
# cut a contract off before its schedules.
AGENT_MAX_CHARS_CONVENING=200000
AGENT_MODEL_BRIEF=claude-sonnet-5
AGENT_MODEL_AUTHORED=claude-sonnet-5
# Output ceiling. Thinking tokens count against this on the Opus 5 family, and
# hitting it truncates the brief mid-answer.
AGENT_MAX_TOKENS=16000
# low | medium | high | xhigh | max. The API default is high; medium is enough
# for summarise-and-cite over text that has already been retrieved and filtered.
AGENT_EFFORT=medium
ANTHROPIC_API_KEY=
AGENT_STALE_AFTER_DAYS=30

MAIL_MAILER=log
