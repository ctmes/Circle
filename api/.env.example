APP_NAME=Circle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=circle
DB_USERNAME=circle
DB_PASSWORD=circle

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

# --- Evidence object storage (MinIO in dev, Cloudflare R2 in production) ---
FILESYSTEM_DISK=evidence
AWS_ACCESS_KEY_ID=circle
AWS_SECRET_ACCESS_KEY=circlecircle
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=circle-evidence
AWS_USE_PATH_STYLE_ENDPOINT=true
# Endpoint reachable from inside the container (server-side reads/writes)
AWS_ENDPOINT=http://minio:9000
# Endpoint reachable from the browser. Presigned URLs must be signed against
# the host the browser will actually call, so signing uses this one.
AWS_PUBLIC_ENDPOINT=http://localhost:59000

# --- Circle Steward agent ---
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
AGENT_STALE_AFTER_DAYS=30

MAIL_MAILER=log
