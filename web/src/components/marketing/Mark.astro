---
/**
 * The product mark, in Astro.
 *
 * Identical geometry to `Wordmark.tsx` in the app — a ring with a filled centre,
 * the boundary and the thing it is drawn around. It is duplicated rather than
 * imported because the public site ships no React, and one <svg> is a cheaper
 * duplication than an island on every page.
 */
interface Props {
  size?: number;
  /** Hides the word, leaving only the ring. Used in the footer's compact rows. */
  glyphOnly?: boolean;
  class?: string;
}

const { size = 17, glyphOnly = false, class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width={size * 1.5}
    height={size * 1.5}
    viewBox="0 0 32 32"
    aria-hidden="true"
    class="shrink-0"
  >
    <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2.25" />
    <circle cx="16" cy="16" r="4.5" fill="var(--accent)" />
  </svg>

  {
    !glyphOnly && (
      <span
        class="display block font-[650] leading-none text-[var(--ink)]"
        style={`font-size:${size}px`}
      >
        Circle
      </span>
    )
  }
</span>
