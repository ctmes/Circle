---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Circle</title>
    <meta
      name="description"
      content="A trusted, temporary operating environment for organisations collaborating on a consequential outcome."
    />
    <!--
      Light is the default everywhere; the OS setting is deliberately not
      consulted. This runs before the first paint so a reader who has chosen
      dark never sees a white flash on navigation.
    -->
    <script is:inline>
      (() => {
        const THEME_COLOR = { light: "#fbfbfd", dark: "#000000" };

        const stored = () => {
          try {
            return localStorage.getItem("circle-theme") === "dark" ? "dark" : "light";
          } catch {
            /* Storage can be blocked entirely; light is the correct fallback. */
            return "light";
          }
        };

        const apply = (doc) => {
          const theme = stored();

          if (theme === "dark") {
            doc.documentElement.dataset.theme = "dark";
          } else {
            delete doc.documentElement.dataset.theme;
          }

          doc
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", THEME_COLOR[theme]);
        };

        apply(document);

        /*
          A view-transition swap replaces every attribute on <html> with the
          incoming document's, and the head script above is deduped rather than
          re-run — so without this the reader's choice is dropped on the first
          tab change. Stamping the incoming document before the swap means the
          new page is painted in the right theme, with no flash of the other.

          The listener outlives the swap because `document` itself is never
          replaced, which is also why it is registered exactly once.
        */
        document.addEventListener("astro:before-swap", (event) => apply(event.newDocument));
      })();
    </script>
    <meta name="theme-color" content="#fbfbfd" />

    <!--
      Moving between the ten Circle views swaps the document instead of
      reloading it. The point is not the animation: a full reload tears down
      the JS context, so every island remounted and refetched from nothing —
      including the Circle itself, which is identical on all ten tabs. Keeping
      the context alive is what lets `useAsync` reuse it (see ui.tsx).
    -->
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Inter is the fallback for platforms without SF Pro; Apple devices never
      download it, because the stack in global.css resolves to the system face
      first. JetBrains Mono covers hashes and identifiers on the same terms.
    -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='12' fill='none' stroke='%231c1c1e' stroke-width='2.5'/%3E%3Ccircle cx='16' cy='16' r='4' fill='%230071e3'/%3E%3C/svg%3E"
    />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
