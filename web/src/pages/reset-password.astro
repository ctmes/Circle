---
import Base from "../layouts/Base.astro";
import { RecoverView } from "../components/RecoverView";

// Read on the server so the island renders the right half first time. A person
// arriving here has clicked a link from an email because they cannot get in;
// the page flashing the wrong form at them is a poor first impression at the
// worst moment.
const token = Astro.url.searchParams.get("token") ?? "";
const email = Astro.url.searchParams.get("email") ?? "";
---
<Base title="Set a new password">
  <RecoverView token={token} emailFromLink={email} client:load />
</Base>
