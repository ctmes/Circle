# Circle — PHP 8.4 FPM runtime, for serving the API behind a real web server.
#
# The CLI image in this directory runs `artisan serve`, which is a development
# server: single-threaded, no process management, and documented by PHP itself
# as unsuitable for production. This image is the same runtime with the same
# extensions and the same media toolchain, under FPM, so the only thing that
# differs between running Circle locally and running it for real is which
# process answers the socket.
FROM php:8.4-fpm-bookworm

COPY --from=mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/

RUN install-php-extensions \
      pdo_pgsql pgsql redis gd exif zip bcmath pcntl intl opcache sockets

# Identical to the CLI image: the extraction jobs run under the queue worker,
# but a failed synchronous extraction would otherwise fail differently here
# than it does locally, which is the worst kind of environment difference.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg \
      poppler-utils \
      tesseract-ocr tesseract-ocr-eng \
      git unzip ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_MEMORY_LIMIT=-1

# Opcache on, with the validate-timestamps check off: checking every file on
# every request is the single cheapest thing to stop doing. The price is that
# FPM never notices a change on disk. The production compose file bind-mounts
# the code, so a `git pull` or a `config:cache` is invisible to a running `api`
# container until it is restarted — which is why DEPLOY.md restarts it after
# both.
RUN { \
      echo "opcache.enable=1"; \
      echo "opcache.validate_timestamps=0"; \
      echo "opcache.memory_consumption=192"; \
      echo "opcache.max_accelerated_files=20000"; \
      echo "opcache.interned_strings_buffer=16"; \
    } > /usr/local/etc/php/conf.d/opcache.ini

# A site video is the largest thing anybody uploads, and it goes straight to
# object storage rather than through PHP — but the export packet is built in
# PHP and a long mission's packet is not small.
RUN { \
      echo "memory_limit=512M"; \
      echo "max_execution_time=300"; \
      echo "upload_max_filesize=32M"; \
      echo "post_max_size=32M"; \
      echo "expose_php=off"; \
    } > /usr/local/etc/php/conf.d/circle.ini

WORKDIR /app
